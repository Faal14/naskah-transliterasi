# Database (Supabase): pooler untuk aplikasi, direct untuk migrasi
DATABASE_URL=
DIRECT_URL=
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Auth.js
AUTH_SECRET=        # openssl rand -base64 32
AUTH_URL=           # contoh: https://host/oase1/api/auth
NEXTAUTH_URL=       # sama dengan AUTH_URL (dibaca klien next-auth, ditanam saat build)
# Sub-path deploy (kosongkan jika root atau subdomain), contoh: /oase1
NEXT_PUBLIC_BASE_PATH=
# Rate limit: jumlah proxy tepercaya di depan aplikasi (bawaan 1 = Nginx saja).
# IP klien diambil dari entri ke-N dari kanan pada x-forwarded-for. Naikkan menjadi 2
# bila ada load balancer lain di depan Nginx. Dibaca saat runtime (cukup di env server).
TRUSTED_PROXY_HOPS=
# Hanya untuk seed
ADMIN_INITIAL_PASSWORD=
